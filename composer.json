{
    "name": "danog/php-rtc-codecs",
    "type": "library",
    "description": "WebRTC audio/video codec and RTP packetization utilities. MadelineProto's PHP 8.2+ fork adds optional transcoding FFI, VP9 packetization, and the modular danog/php-rtc stack.",
    "keywords": [
        "webrtc",
        "codecs",
        "h264",
        "vp8",
        "opus",
        "pcma",
        "pcmu"
    ],
    "homepage": "https://github.com/danog/php-rtc-codecs",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "danog/php-rtc-exception": "^1.0",
        "danog/php-rtc-av": "^1.0",
        "danog/php-rtc-rtp-parameter": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "bamarni/composer-bin-plugin": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\Codecs\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\Codecs\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "suggest": {
        "ext-ffi": "Install the FFI extension and libopus/libvpx/libavcodec to transcode media; not required to packetize already-encoded media"
    },
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
